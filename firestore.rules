rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function inConversation(conversationId) {
      return signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/Conversations/$(conversationId)).data.participants;
    }

    match /Conversations/{conversationId} {
      allow read: if inConversation(conversationId);

      allow create: if signedIn() &&
          request.resource.data.participants is list &&
          request.auth.uid in request.resource.data.participants &&
          request.resource.data.participants.size() == 2;

      allow update: if inConversation(conversationId) &&
          request.resource.data.participants == resource.data.participants;

        allow delete: if inConversation(conversationId);

      match /Messages/{messageId} {
        allow read: if inConversation(conversationId);

        allow create: if inConversation(conversationId) &&
            request.resource.data.senderId == request.auth.uid &&
            request.resource.data.text is string;

        allow update: if inConversation(conversationId) &&
            request.resource.data.senderId == resource.data.senderId &&
            request.resource.data.text == resource.data.text;

        allow delete: if inConversation(conversationId);
      }
    }

    match /Users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /Admins/{adminId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == adminId
        && request.resource.data.Approved == false;
      allow update: if signedIn()
        && request.auth.uid == adminId
        && request.resource.data.Approved == resource.data.Approved;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
